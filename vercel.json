{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/referral",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/referral/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/referral/index",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/crmdashboard",
      "destination": "/crmdashboard.html"
    }
  ]
}
